    <mxCell id="title" value="ONE WORK UNIT · MANUALLY STARTED · FINITE LIMITS" style="text;html=0;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1440" height="60" as="geometry"/></mxCell>
    <mxCell id="plan" value="PLAN&#xa;Original request + sources&#xa;Owner + finite allowance" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1ecfa;strokeColor=#42658a;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="270" height="140" as="geometry"/></mxCell>
    <mxCell id="produce" value="DO — CODEX&#xa;Produce an identified&#xa;candidate" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1ecfa;strokeColor=#42658a;fontSize=20;" vertex="1" parent="1"><mxGeometry x="410" y="120" width="270" height="140" as="geometry"/></mxCell>
    <mxCell id="check" value="CHECK — CLAUDE&#xa;Original request + candidate&#xa;+ source evidence" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4e0f7;strokeColor=#665493;fontSize=20;" vertex="1" parent="1"><mxGeometry x="780" y="120" width="300" height="140" as="geometry"/></mxCell>
    <mxCell id="ready" value="PASS + DATA CHECKS PASS&#xa;Ready for publication&#xa;Host publishes; human accepts" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ddf0e2;strokeColor=#3d7450;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1180" y="120" width="340" height="140" as="geometry"/></mxCell>
    <mxCell id="act" value="ACT — CODEX&#xa;Apply or dispute each finding&#xa;with evidence" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0cf;strokeColor=#ad8126;fontSize=20;" vertex="1" parent="1"><mxGeometry x="780" y="400" width="300" height="140" as="geometry"/></mxCell>
    <mxCell id="stop" value="STOP + SAVE EVIDENCE&#xa;No progress, uncertainty, failure,&#xa;cancellation or exhausted limit" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f9dfdc;strokeColor=#a65049;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1180" y="400" width="340" height="140" as="geometry"/></mxCell>
    <mxCell id="note" value="Before every AI call: check cancellation, remaining time, call allowance and persistent reservation.&#xa;Every phase saves context and results. Model agreement is evidence to assess, not proof of truth.&#xa;This reference automates local PDCA; queue pickup and connected publishing belong to later units." style="text;whiteSpace=wrap;html=0;fontSize=20;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1480" height="110" as="geometry"/></mxCell>
