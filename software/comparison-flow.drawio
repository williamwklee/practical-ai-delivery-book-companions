<mxfile host="Electron" version="31.4.5"><diagram id="BOOK-VIS-020" name="Comparison with an explicit stop"><mxGraphModel page="1" pageWidth="1100" pageHeight="480"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Small calculation, clear stopping point" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;text;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="10" width="1040" height="45" /></mxCell><mxCell id="input" value="Read exactly&#10;two amounts" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;rounded=1;fillColor=#DAE8FC;strokeColor=#3969AC;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="120" width="235" height="90" /></mxCell><mxCell id="valid" value="Inputs valid?" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;rhombus;fillColor=#FFF2CC;strokeColor=#B58A16;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="105" width="190" height="115" /></mxCell><mxCell id="calculate" value="Calculate and round&#10;with Decimal" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;rounded=1;fillColor=#D5E8D4;strokeColor=#008B8B;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="120" width="340" height="90" /></mxCell><mxCell id="stop" value="STOP · exit 2&#10;No result; explain input" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;rounded=1;fillColor=#F8CECC;strokeColor=#A33A34;" vertex="1" parent="1"><mxGeometry as="geometry" x="315" y="310" width="290" height="90" /></mxCell><mxCell id="output" value="JSON result · exit 0&#10;25% above; 125% of" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;rounded=1;fillColor=#D5E8D4;strokeColor=#008B8B;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="310" width="340" height="90" /></mxCell><mxCell id="foot" value="Correct an input explicitly, then start a separate invocation. The program never retries itself.&#10;Illustration uses fictional 100 and 80; the calculator supports the full stated decimal contract." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;text;strokeColor=none;fillColor=none;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="435" width="1050" height="65" /></mxCell><mxCell id="e1" value="" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#315472;" edge="1" source="input" target="valid" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="yes" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#315472;" edge="1" source="valid" target="calculate" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="no" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#315472;" edge="1" source="valid" target="stop" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#315472;" edge="1" source="calculate" target="output" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>