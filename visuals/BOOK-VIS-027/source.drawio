<mxfile host="Electron" version="31.4.5"><diagram id="BOOK-VIS-027" name="Act on the finding, then decide the next step"><mxGraphModel page="1" pageWidth="1100" pageHeight="420"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Act on the finding, then decide the next step" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;text;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="10" width="1040" height="50" /></mxCell><mxCell id="s0" value="READ&#10;Exact finding + version&#10;Evidence and consequence" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;rounded=1;fillColor=#DAE8FC;strokeColor=#315472;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="115" width="245" height="115" /></mxCell><mxCell id="s1" value="RESPOND&#10;Correct or disagree&#10;Clarify or escalate" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;rounded=1;fillColor=#DAE8FC;strokeColor=#315472;" vertex="1" parent="1"><mxGeometry as="geometry" x="285" y="115" width="245" height="115" /></mxCell><mxCell id="e1" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#315472;" edge="1" source="s0" target="s1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="RECHECK&#10;Changed output or claim&#10;Same agreed criteria" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;rounded=1;fillColor=#FFF2CC;strokeColor=#315472;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="115" width="245" height="115" /></mxCell><mxCell id="e2" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#315472;" edge="1" source="s1" target="s2" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="DECIDE&#10;