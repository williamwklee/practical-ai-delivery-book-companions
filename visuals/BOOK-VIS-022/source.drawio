<mxfile host="Electron" version="31.4.5"><diagram id="BOOK-VIS-022" name="Delivery and closure"><mxGraphModel page="1" pageWidth="1120" pageHeight="680"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Deliver first, then close with recorded authority" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;text;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="10" width="1060" height="50" /></mxCell><mxCell id="verify" value="Verify final output&#10;Criteria + independent audit" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;rounded=1;fillColor=#DAE8FC;strokeColor=#3969AC;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="105" width="300" height="100" /></mxCell><mxCell id="publish" value="Publish complete record&#10;Text + visuals + exact files" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;rounded=1;fillColor=#DAE8FC;strokeColor=#3969AC;" vertex="1" parent="1"><mxGeometry as="geometry" x="395" y="105" width="300" height="100" /></mxCell><mxCell id="reopen" value="Retrieve and check&#10;Saved pages + exact files" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;rounded=1;fillColor=#D5E8D4;strokeColor=#008B8B;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="105" width="300" height="100" /></mxCell><mxCell id="decision" value="Authority to&#10;close recorded?" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;rhombus;fillColor=#FFF2CC;strokeColor=#B58A16;" vertex="1" parent="1"><mxGeometry as="geometry" x="790" y="290" width="250" height="140" /></mxCell><mxCell id="human" value="Awaiting Acceptance&#10;Named person decides" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;rounded=1;fillColor=#FFF2CC;strokeColor=#B58A16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="315" width="310" height="100" /></mxCell><mxCell id="done" value="Record decision → Done&#10;Retire unused capacity" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;rounded=1;fillColor=#D5E8D4;strokeColor=#008B8B;" vertex="1" parent="1"><mxGeometry as="geometry" x="575" y="490" width="395" height="100" /></mxCell><mxCell id="foot" value="A missing criterion or required check prevents completion. Preserve partial work and the stop reason.&#10;A clean review supports the decision; it does not grant new authority or approve public release." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;text;strokeColor=none;fillColor=none;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="635" width="1060" height="65" /></mxCell><mxCell id="e1" value="" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#315472;" edge="1" source="verify" target="publish" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#315472;" edge="1" source="publish" target="reopen" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#315472;" edge="1" source="reopen" target="decision" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="yes" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#315472;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" source="decision" target="done" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="no" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#315472;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="decision" target="human" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="accepted" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=20;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#315472;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" source="human" target="done" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>