<mxfile host="Electron" version="31.4.5">
 <diagram id="durable-records" name="Durable records for one work unit">
  <mxGraphModel dx="1600" dy="850" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="850">
   <root><mxCell id="0" /><mxCell id="1" parent="0" />
    <mxCell id="title" value="VERSIONED FILES · EDITABLE SOURCE · EXACT COMMIT" style="text;html=0;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1440" height="60" as="geometry" /></mxCell>
    <mxCell id="plan" value="PLAN RECORD&#10;Intent + inputs + limits" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1ecfa;strokeColor=#42658a;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="270" height="140" as="geometry" /></mxCell>
    <mxCell id="produce" value="WORKING RECORD&#10;Candidate + source versions" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1ecfa;strokeColor=#42658a;fontSize=20;" vertex="1" parent="1"><mxGeometry x="410" y="120" width="270" height="140" as="geometry" /></mxCell>
    <mxCell id="check" value="REVIEW RECORD&#10;Full report + findings" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4e0f7;strokeColor=#665493;fontSize=20;" vertex="1" parent="1"><mxGeometry x="780" y="120" width="300" height="140" as="geometry" /></mxCell>
    <mxCell id="ready" value="DELIVERY RECORD&#10;Complete text + visuals&#10;Publisher saves; human accepts" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ddf0e2;strokeColor=#3d7450;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1180" y="120" width="340" height="140" as="geometry" /></mxCell>
    <mxCell id="act" value="DECISION + LESSON&#10;Supported correction&#10;Retain superseded versions" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0cf;strokeColor=#ad8126;fontSize=20;" vertex="1" parent="1"><mxGeometry x="780" y="400" width="300" height="140" as="geometry" /></mxCell>
    <mxCell id="stop" value="STOP RECORD&#10;Reason + counters + owner&#10;Next permitted action" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f9dfdc;strokeColor=#a65049;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1180" y="400" width="340" height="140" as="geometry" /></mxCell>
    <mxCell id="note" value="Confluence holds the complete records and visuals. Jira controls work state; GitHub retains editable files.&#10;Each record names the current revision and links to its exact evidence. A fresh session reads these records.&#10;Plan, work, review and correct within the same finite allowance. A passed review is not human acceptance." style="text;whiteSpace=wrap;html=0;fontSize=20;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1480" height="110" as="geometry" /></mxCell>
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="plan" target="produce"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="produce" target="check"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e3" value="pass" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeWidth=2;fontSize=18;" edge="1" parent="1" source="check" target="ready"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e4" value="finding" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeWidth=2;fontSize=18;exitX=0.35;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="check" target="act"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e5" value="changed candidate" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeWidth=2;fontSize=16;exitX=0;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="act" target="check"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e6" value="stop condition" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeWidth=2;fontSize=18;" edge="1" parent="1" source="act" target="stop"><mxGeometry relative="1" as="geometry" /></mxCell>
