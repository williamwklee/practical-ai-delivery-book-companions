<mxfile host="Electron" version="31.4.5"><diagram id="BOOK-VIS-009" name="Recovery"><mxGraphModel dx="1420" dy="720" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="Restart from the original records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="220" height="80" as="geometry" /></mxCell><mxCell id="inspect" value="Inspect the previous process and output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="320" y="160" width="240" height="80" as="geometry" /></mxCell><mxCell id="match" value="Existing output matches?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;" vertex="1" parent="1"><mxGeometry x="620" y="140" width="180" height="120" as="geometry" /></mxCell><mxCell id="settle" value="Finish the missing record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="870" y="30" width="220" height="80" as="geometry" /></mxCell><mxCell id="check" value="Recheck authority, owner and allowance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="860" y="230" width="250" height="80" as="geometry" /></mxCell><mxCell id="resume" value="One permitted attempt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1170" y="230" width="210" height="80" as="geometry" /></mxCell><mxCell id="stop" value="Stop and preserve uncertainty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;" vertex="1" parent="1"><mxGeometry x="870" y="410" width="240" height="80" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=15;" edge="1" parent="1" source="start" target="inspect"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=15;" edge="1" parent="1" source="inspect" target="match"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=15;" edge="1" parent="1" source="match" target="settle"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="No: absent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=15;" edge="1" parent="1" source="match" target="check"><mxGeometry relative="1" as="geometry"><mxPoint x="-40" y="25" as="offset" /></mxGeometry></mxCell><mxCell id="e4" value="Unknown or conflict" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=15;" edge="1" parent="1" source="match" target="stop"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="450" /></Array></mxGeometry></mxCell><mxCell id="e5" value="Permitted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=15;" edge="1" parent="1" source="check" target="resume"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="Not permitted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=15;" edge="1" parent="1" source="check" target="stop"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>